<!-- Ringing calendar alarm notification: title, time and the profile's three snooze lengths. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <TextView
        android:id="@+id/title"
        style="@style/TextAppearance.Compat.Notification.Title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:singleLine="true"
        tools:text="Alarm: Meeting" />

    <TextView
        android:id="@+id/time"
        style="@style/TextAppearance.Compat.Notification"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:singleLine="true"
        tools:text="07:00" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            style="@style/TextAppearance.Compat.Notification"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:singleLine="true"
            android:text="@string/button_action_snooze" />

        <TextView
            android:id="@+id/snooze_1"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/calendar_snooze_chip"
            android:gravity="center"
            android:minWidth="56dp"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:maxLines="1"
            android:textColor="#FFFFFFFF"
            android:textSize="14sp"
            android:textStyle="bold"
            tools:text="+5" />

        <TextView
            android:id="@+id/snooze_2"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/calendar_snooze_chip"
            android:gravity="center"
            android:minWidth="56dp"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:maxLines="1"
            android:textColor="#FFFFFFFF"
            android:textSize="14sp"
            android:textStyle="bold"
            tools:text="+10" />

        <TextView
            android:id="@+id/snooze_3"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:background="@drawable/calendar_snooze_chip"
            android:gravity="center"
            android:minWidth="56dp"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:maxLines="1"
            android:textColor="#FFFFFFFF"
            android:textSize="14sp"
            android:textStyle="bold"
            tools:text="+20" />
    </LinearLayout>

    <TextView
        android:id="@+id/extend_hint"
        style="@style/TextAppearance.Compat.Notification"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxLines="2"
        android:visibility="gone"
        tools:text="@string/calendar_alarm_snooze_extends"
        tools:visibility="visible" />
</LinearLayout>
