<!-- Folded and heads-up view of a ringing calendar alarm: Android gives it only about 48 dp, so
     the title and the snooze bubbles share one line, with the extend line below when it applies. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/title"
            style="@style/TextAppearance.Compat.Notification.Title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            tools:text="Alarm: Meeting" />

        <TextView
            android:id="@+id/snooze_1"
            android:layout_width="wrap_content"
            android:layout_height="30dp"
            android:background="@drawable/calendar_snooze_chip"
            android:gravity="center"
            android:maxLines="1"
            android:minWidth="48dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:textColor="#FFFFFFFF"
            android:textSize="14sp"
            android:textStyle="bold"
            tools:text="+5" />

        <TextView
            android:id="@+id/snooze_2"
            android:layout_width="wrap_content"
            android:layout_height="30dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/calendar_snooze_chip"
            android:gravity="center"
            android:maxLines="1"
            android:minWidth="48dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:textColor="#FFFFFFFF"
            android:textSize="14sp"
            android:textStyle="bold"
            tools:text="+5" />

        <TextView
            android:id="@+id/snooze_3"
            android:layout_width="wrap_content"
            android:layout_height="30dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/calendar_snooze_chip"
            android:gravity="center"
            android:maxLines="1"
            android:minWidth="48dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:textColor="#FFFFFFFF"
            android:textSize="14sp"
            android:textStyle="bold"
            tools:text="+5" />
    </LinearLayout>

    <TextView
        android:id="@+id/extend_hint"
        style="@style/TextAppearance.Compat.Notification"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:maxLines="1"
        android:ellipsize="end"
        android:textSize="12sp"
        android:visibility="gone"
        tools:text="@string/calendar_alarm_snooze_extends"
        tools:visibility="visible" />
</LinearLayout>
