<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="8dp"
        android:paddingBottom="32dp">

        <!-- General -->
        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/calendar_alert_profile_name">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/name_input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textCapSentences"
                android:maxLines="1" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/enabled_switch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:minHeight="48dp"
            android:text="@string/calendar_alert_profile_enabled"
            android:textSize="16sp" />

        <!-- Calendar and filter -->
        <com.google.android.material.textview.MaterialTextView
            style="@style/CalendarAlertSectionTitle"
            android:text="@string/calendar_alert_section_calendar" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/calendar_button"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="start|center_vertical"
            android:text="@string/calendar_alert_choose_calendar"
            app:icon="@drawable/ic_calendar_clock" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/regex_layout"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="@string/calendar_alert_title_regex"
            app:helperText="@string/calendar_alert_title_regex_help"
            app:helperTextEnabled="true">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/regex_input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:inputType="text"
                android:maxLines="1" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/ignore_case_switch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="@string/calendar_alert_ignore_case"
            android:textSize="16sp" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/lookahead_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textSize="16sp" />

        <com.google.android.material.slider.Slider
            android:id="@+id/lookahead_slider"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:stepSize="1"
            android:valueFrom="7"
            android:valueTo="30" />

        <com.google.android.material.textview.MaterialTextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/calendar_alert_lookahead_help"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="13sp" />

        <!-- Which events -->
        <com.google.android.material.textview.MaterialTextView
            style="@style/CalendarAlertSectionTitle"
            android:text="@string/calendar_alert_section_events" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/skip_declined_switch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="@string/calendar_alert_skip_declined"
            android:textSize="16sp" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/skip_tentative_switch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="@string/calendar_alert_skip_tentative"
            android:textSize="16sp" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/all_day_switch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="@string/calendar_alert_all_day"
            android:textSize="16sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/all_day_time_button"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="start|center_vertical" />

        <!-- Sound -->
        <com.google.android.material.textview.MaterialTextView
            style="@style/CalendarAlertSectionTitle"
            android:text="@string/calendar_alert_section_sound" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/vibrate_only_switch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="@string/calendar_alert_vibrate_only"
            android:textSize="16sp" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/flash_only_switch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="@string/calendar_alert_flash_only"
            android:textSize="16sp" />

        <LinearLayout
            android:id="@+id/sound_fields"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/ringtone_button"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="start|center_vertical"
                app:icon="@drawable/ic_ringtone" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/volume_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:textSize="16sp" />

            <com.google.android.material.slider.Slider
                android:id="@+id/volume_slider"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:stepSize="1"
                android:valueFrom="0"
                android:valueTo="7" />

            <com.google.android.material.textview.MaterialTextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/calendar_alert_volume_help"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="13sp" />
        </LinearLayout>

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/vibrate_switch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:minHeight="48dp"
            android:text="@string/calendar_alert_vibrate"
            android:textSize="16sp" />

        <LinearLayout
            android:id="@+id/vibration_strength_fields"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/vibration_strength_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textSize="16sp" />

            <com.google.android.material.slider.Slider
                android:id="@+id/vibration_strength_slider"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:stepSize="10"
                android:value="100"
                android:valueFrom="10"
                android:valueTo="100" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/vibration_strength_help"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/calendar_alert_vibration_strength_unsupported"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="13sp" />
        </LinearLayout>

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/flash_switch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="@string/calendar_alert_flash"
            android:textSize="16sp" />

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="@string/calendar_alert_max_duration"
            app:helperText="@string/calendar_alert_max_duration_help"
            app:helperTextEnabled="true">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/max_duration_input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="number"
                android:maxLength="4"
                android:maxLines="1" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Snooze -->
        <com.google.android.material.textview.MaterialTextView
            style="@style/CalendarAlertSectionTitle"
            android:text="@string/calendar_alert_section_snooze" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/snooze_switch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="@string/calendar_alert_allow_snooze"
            android:textSize="16sp" />

        <LinearLayout
            android:id="@+id/snooze_fields"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:hint="@string/calendar_alert_snooze_minutes">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/snooze_minutes_input"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="number"
                    android:maxLength="3"
                    android:maxLines="1" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:hint="@string/calendar_alert_max_snoozes"
                app:helperText="@string/calendar_alert_max_snoozes_help"
                app:helperTextEnabled="true">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/max_snoozes_input"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="number"
                    android:maxLength="2"
                    android:maxLines="1" />
            </com.google.android.material.textfield.TextInputLayout>
        </LinearLayout>

        <!-- Dismiss -->
        <com.google.android.material.textview.MaterialTextView
            style="@style/CalendarAlertSectionTitle"
            android:text="@string/calendar_alert_section_dismiss" />

        <RadioGroup
            android:id="@+id/dismiss_group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <com.google.android.material.radiobutton.MaterialRadioButton
                android:id="@+id/dismiss_default"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/calendar_alert_dismiss_default" />

            <com.google.android.material.radiobutton.MaterialRadioButton
                android:id="@+id/dismiss_slide"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/calendar_alert_dismiss_slide" />

            <com.google.android.material.radiobutton.MaterialRadioButton
                android:id="@+id/dismiss_button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/calendar_alert_dismiss_button" />
        </RadioGroup>

        <!-- Actions -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/save_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/calendar_alert_save" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/delete_button"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/calendar_alert_delete_profile"
            android:textColor="?attr/colorError"
            android:visibility="gone"
            app:icon="@drawable/ic_delete"
            app:iconTint="?attr/colorError" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
