<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/alarm_root_view"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layoutDirection="ltr"
    tools:background="#191C1E">

    <ImageView
        android:id="@+id/alarm_background_image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/black"
        android:scaleType="centerCrop"
        android:visibility="gone"
        android:contentDescription="@null" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/content_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/alarm_vertical_start_guide"
            android:orientation="vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintGuide_percent="0.05" />

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/alarm_vertical_center_guide"
            android:orientation="vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintGuide_percent="0.5" />

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/alarm_vertical_end_guide"
            android:orientation="vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintGuide_percent="0.95" />

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/alarm_horizontal_middle_guide"
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintGuide_percent="0.5" />

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/alarm_horizontal_end_guide"
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintGuide_percent="0.70" />

        <!-- Clock view -->
        <FrameLayout
            android:id="@+id/clock_layout"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toTopOf="@+id/calendar_info">

            <com.best.deskclock.uicomponents.AnalogClock
                android:id="@+id/analog_clock"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                tools:visibility="gone" />

            <com.best.deskclock.uicomponents.AutoSizingTextClock
                android:id="@+id/digital_clock"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="10dp"
                android:layout_gravity="center"
                android:gravity="center_horizontal"
                android:includeFontPadding="false"
                android:singleLine="true"
                tools:text="12:34"
                tools:textSize="70sp"
                tools:textColor="@android:color/white" />

        </FrameLayout>

        <!-- Description and place of a calendar event (calendar alarms only) -->
        <LinearLayout
            android:id="@+id/calendar_info"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="10dp"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:visibility="gone"
            app:layout_constraintStart_toEndOf="@+id/alarm_vertical_start_guide"
            app:layout_constraintEnd_toEndOf="@+id/alarm_vertical_end_guide"
            app:layout_constraintBottom_toTopOf="@+id/alarm_title"
            tools:visibility="visible">

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/calendar_countdown"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:gravity="center_horizontal"
                android:textColor="@android:color/white"
                android:textSize="18sp"
                android:textStyle="bold"
                android:visibility="gone"
                tools:text="Event in 2 h 15 min"
                tools:visibility="visible" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/calendar_description"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:maxLines="4"
                android:scrollbars="vertical"
                android:textColor="@android:color/white"
                android:textSize="16sp"
                android:visibility="gone"
                tools:text="Bring the insurance card"
                tools:visibility="visible" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/calendar_location"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:background="?attr/selectableItemBackground"
                android:drawableStart="@drawable/ic_calendar_alarm_location"
                android:drawablePadding="6dp"
                android:ellipsize="end"
                android:gravity="center_vertical"
                android:maxLines="2"
                android:minHeight="48dp"
                android:paddingHorizontal="8dp"
                android:textColor="@android:color/white"
                android:textSize="16sp"
                android:visibility="gone"
                tools:text="Bahnhofstrasse 1, Zürich"
                tools:visibility="visible" />
        </LinearLayout>

        <!-- Alarm title -->
        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/alarm_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="10dp"
            android:paddingVertical="10dp"
            android:gravity="center_horizontal"
            android:singleLine="true"
            android:ellipsize="marquee"
            android:marqueeRepeatLimit="marquee_forever"
            android:scrollHorizontally="true"
            app:layout_constraintStart_toEndOf="@+id/alarm_vertical_start_guide"
            app:layout_constraintEnd_toEndOf="@+id/alarm_vertical_end_guide"
            app:layout_constraintBottom_toTopOf="@+id/alarm_horizontal_middle_guide"
            tools:text="@string/menu_alarm"
            tools:textStyle="bold"
            tools:textSize="26sp"
            tools:textColor="@android:color/white" />

        <!-- Snooze button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/snooze_button"
            android:layout_width="0dp"
            android:layout_height="80dp"
            android:layout_marginHorizontal="12dp"
            android:textSize="20sp"
            android:textColor="@android:color/white"
            android:includeFontPadding="false"
            android:singleLine="true"
            android:ellipsize="marquee"
            android:marqueeRepeatLimit="marquee_forever"
            android:scrollHorizontally="true"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/alarm_vertical_center_guide"
            app:layout_constraintBottom_toTopOf="@+id/alarm_horizontal_end_guide"
            tools:text="@string/alarm_alert_snooze_text"
            tools:textStyle="bold"
            tools:visibility="gone" />

        <!-- Dismiss button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/dismiss_button"
            android:layout_width="0dp"
            android:layout_height="80dp"
            android:layout_marginHorizontal="12dp"
            android:textSize="20sp"
            android:textColor="@android:color/white"
            android:includeFontPadding="false"
            android:singleLine="true"
            android:ellipsize="marquee"
            android:marqueeRepeatLimit="marquee_forever"
            android:scrollHorizontally="true"
            app:layout_constraintStart_toEndOf="@+id/alarm_vertical_center_guide"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toTopOf="@+id/alarm_horizontal_end_guide"
            tools:text="@string/button_action_dismiss"
            tools:textStyle="bold"
            tools:visibility="gone" />

        <!-- Dismiss only button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/dismiss_only_button"
            android:layout_width="match_parent"
            android:layout_height="80dp"
            android:layout_marginHorizontal="12dp"
            android:textSize="20sp"
            android:textColor="@android:color/white"
            android:includeFontPadding="false"
            android:singleLine="true"
            android:ellipsize="marquee"
            android:marqueeRepeatLimit="marquee_forever"
            android:scrollHorizontally="true"
            app:layout_constraintBottom_toTopOf="@+id/alarm_horizontal_end_guide"
            tools:text="@string/button_action_dismiss"
            tools:textStyle="bold"
            tools:visibility="gone" />

        <!-- Calendar alarm: a big Dismiss bubble, and the profile's snooze lengths below it -->
        <LinearLayout
            android:id="@+id/calendar_actions"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp"
            android:orientation="vertical"
            android:visibility="gone"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toTopOf="@+id/alarm_horizontal_end_guide"
            tools:visibility="visible">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/calendar_dismiss_button"
                android:layout_width="match_parent"
                android:layout_height="72dp"
                android:includeFontPadding="false"
                android:singleLine="true"
                android:text="@string/button_action_dismiss"
                android:textColor="@android:color/white"
                android:textSize="22sp"
                app:cornerRadius="36dp" />

            <LinearLayout
                android:id="@+id/calendar_snooze_choices"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/calendar_snooze_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="12dp"
                    android:maxLines="1"
                    android:text="@string/button_action_snooze"
                    android:textSize="18sp" />

                <TextView
                    android:id="@+id/calendar_snooze_choice_1"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="12dp"
                    android:gravity="center"
                    android:maxLines="1"
                    android:textSize="18sp"
                    tools:text="+5" />

                <TextView
                    android:id="@+id/calendar_snooze_choice_2"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="12dp"
                    android:gravity="center"
                    android:maxLines="1"
                    android:textSize="18sp"
                    tools:text="+5" />

                <TextView
                    android:id="@+id/calendar_snooze_choice_3"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:maxLines="1"
                    android:textSize="18sp"
                    tools:text="+5" />
            </LinearLayout>

            <TextView
                android:id="@+id/calendar_extend_hint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:text="@string/calendar_alarm_snooze_extends"
                android:textSize="14sp"
                android:visibility="gone"
                tools:visibility="visible" />
        </LinearLayout>

        <!-- Slide zone -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/slide_zone_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp"
            android:paddingHorizontal="12dp"
            android:clipToPadding="false"
            app:layout_constraintBottom_toTopOf="@+id/alarm_horizontal_end_guide"
            tools:background="@drawable/bg_alarm_slide_zone">

            <!-- Pill in the background of the Alarm button -->
            <com.best.deskclock.uicomponents.PillView
                android:id="@+id/pill"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:gravity="center"
                android:layerType="hardware"
                android:clickable="false"
                android:focusable="false"
                android:importantForAccessibility="no"
                tools:fillColor="@color/md_theme_onSurfaceVariant"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@id/alarm_button"
                app:layout_constraintBottom_toBottomOf="@id/alarm_button" />

            <!-- Snooze text -->
            <com.best.deskclock.uicomponents.AutoSizingTextView
                android:id="@+id/snooze_text"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:paddingStart="@null"
                android:paddingEnd="6dp"
                android:paddingVertical="10dp"
                android:textSize="18sp"
                android:gravity="start|center_vertical"
                android:singleLine="true"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/alarm_button"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                tools:text="@string/button_action_snooze"
                tools:textStyle="bold"
                tools:textColor="@android:color/white" />

            <!-- Dismiss text -->
            <com.best.deskclock.uicomponents.AutoSizingTextView
                android:id="@+id/dismiss_text"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:paddingStart="6dp"
                android:paddingEnd="@null"
                android:paddingVertical="10dp"
                android:textSize="18sp"
                android:gravity="end|center_vertical"
                android:singleLine="true"
                app:layout_constraintStart_toEndOf="@+id/alarm_button"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                tools:text="@string/button_action_dismiss"
                tools:textStyle="bold"
                tools:textColor="@android:color/white" />

            <!-- Alarm button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/alarm_button"
                android:layout_width="wrap_content"
                android:layout_height="60dp"
                android:layout_marginVertical="10dp"
                app:icon="@drawable/ic_tab_alarm_static"
                app:iconSize="24dp"
                app:iconTint="@android:color/white"
                app:iconGravity="textStart"
                app:iconPadding="0dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                tools:backgroundTint="@color/md_theme_primary" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- Hint: swipe down to permanently disable a repeating alarm -->
        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/disable_hint_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:textSize="14sp"
            android:visibility="gone"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/slide_zone_layout"
            tools:text="@string/swipe_down_to_disable_hint"
            tools:textColor="@android:color/white"
            tools:visibility="visible" />

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/snooze_selector_layout"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginHorizontal="20dp"
            android:gravity="center_vertical"
            app:layout_constraintTop_toBottomOf="@+id/disable_hint_text"
            app:layout_constraintBottom_toTopOf="@+id/ringtone_layout">

            <ImageView
                android:id="@+id/snooze_selector_minus"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:padding="12dp"
                android:src="@drawable/ic_minus"
                android:contentDescription="@null"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent" />

            <com.best.deskclock.uicomponents.AutoSizingTextView
                android:id="@+id/snooze_selector_text"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginHorizontal="30dp"
                android:paddingHorizontal="8dp"
                android:textSize="18sp"
                android:gravity="center"
                android:singleLine="true"
                app:layout_constraintStart_toEndOf="@+id/snooze_selector_minus"
                app:layout_constraintEnd_toStartOf="@+id/snooze_selector_plus"
                tools:text="Snooze 5 min"
                tools:textStyle="bold"
                tools:textColor="@android:color/white" />

            <ImageView
                android:id="@+id/snooze_selector_plus"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:padding="12dp"
                android:src="@drawable/ic_add"
                android:contentDescription="@null"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>


        <LinearLayout
            android:id="@+id/ringtone_layout"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="20dp"
            android:gravity="center"
            app:layout_constraintStart_toStartOf="@+id/slide_zone_layout"
            app:layout_constraintEnd_toEndOf="@+id/slide_zone_layout"
            app:layout_constraintBottom_toBottomOf="parent">

            <ImageView
                android:id="@+id/ringtone_icon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingVertical="10dp"
                android:contentDescription="@null"
                tools:src="@drawable/ic_music_note"
                tools:tint="@color/md_theme_outline" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/ringtone_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingHorizontal="10dp"
                android:paddingVertical="10dp"
                android:textSize="18sp"
                android:singleLine="true"
                android:focusable="true"
                android:ellipsize="marquee"
                android:marqueeRepeatLimit="marquee_forever"
                android:scrollHorizontally="true"
                tools:text="Daydream"
                tools:textStyle="bold"
                tools:textColor="@color/md_theme_outline" />

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- View that appears after the alarm has been snoozed or dismissed -->
    <LinearLayout
        android:id="@+id/action_message_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone"
        tools:visibility="visible">

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/action_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/action_description"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:visibility="gone"
            tools:textStyle="bold"
            tools:visibility="visible" />

    </LinearLayout>

</FrameLayout>
