<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="8dp"
        android:paddingBottom="@dimen/calendar_alarm_list_bottom_padding">

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/event_when"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingVertical="6dp"
            android:textSize="18sp"
            tools:text="Tue, 1 Dec 2026 · 17:15" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/event_calendar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="6dp"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="14sp"
            tools:text="denisimmoos@gmail.com" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/event_alarm_state"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="6dp"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="14sp"
            android:visibility="gone"
            tools:text="Already dismissed"
            tools:visibility="visible" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/event_location"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:background="?attr/selectableItemBackground"
            android:drawableStart="@drawable/ic_calendar_alarm_location"
            android:drawablePadding="8dp"
            android:gravity="center_vertical"
            android:minHeight="48dp"
            android:paddingHorizontal="4dp"
            android:textSize="16sp"
            android:visibility="gone"
            tools:text="Bahnhofstrasse 1, Zürich"
            tools:visibility="visible" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/event_description"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:autoLink="web|email|phone"
            android:textIsSelectable="true"
            android:textSize="16sp"
            android:visibility="gone"
            tools:text="Bring the insurance card"
            tools:visibility="visible" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/open_in_calendar_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/calendar_alarm_open_in_calendar" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
