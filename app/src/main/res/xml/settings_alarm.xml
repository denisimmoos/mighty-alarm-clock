<PreferenceScreen
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <PreferenceCategory
        android:title="@string/style_category_title"
        app:allowDividerAbove="false"
        app:iconSpaceReserved="false">

        <Preference
            android:key="key_alarm_display_customization"
            android:layout="@layout/settings_preference_layout"
            android:title="@string/display_settings_title"
            app:iconSpaceReserved="false"
            app:singleLineTitle="false" />

        <Preference
            android:key="key_alarm_font"
            android:layout="@layout/settings_preference_layout"
            app:iconSpaceReserved="false"
            app:singleLineTitle="false"
            tools:title="@string/custom_font_title" />

    </PreferenceCategory>

    <PreferenceCategory
        android:title="@string/ringtone_category_title"
        app:allowDividerAbove="false"
        app:iconSpaceReserved="false">

        <Preference
            android:key="key_default_alarm_ringtone"
            android:layout="@layout/settings_preference_layout"
            android:title="@string/default_alarm_ringtone_title"
            app:iconSpaceReserved="false"
            app:singleLineTitle="false" />

        <com.best.deskclock.settings.custompreference.AlarmVolumePreference
            android:key="key_volume_setting"
            android:layout="@layout/settings_preference_slider_layout"
            android:title="@string/alarm_volume_title"
            android:summary="0"
            app:iconSpaceReserved="false"
            app:singleLineTitle="false" />

        <SwitchPreferenceCompat
            android:key="key_advanced_audio_playback"
            android:layout="@layout/settings_preference_layout"
            android:title="@string/advanced_audio_playback_title"
            android:summary="@string/advanced_audio_playback_summary"
            android:defaultValue="false"
            app:iconSpaceReserved="false"
            app:singleLineTitle="false" />

        <SwitchPreferenceCompat
            android:key="key_auto_routing_to_external_audio_device"
            android:layout="@layout/settings_preference_layout"
            android:title="@string/auto_routing_to_external_audio_device_title"
            android:defaultValue="false"
            app:iconSpaceReserved="false"
            app:singleLineTitle="false" />

        <SwitchPreferenceCompat
            android:key="key_system_media_volume"
            android:layout="@layout/settings_preference_layout"
            android:title="@string/system_media_volume_title"
            android:summary="@string/system_media_volume_summary"
            android:defaultValue="true"
            app:iconSpaceReserved="false"
            app:singleLineTitle="false" />

        <com.best.deskclock.settings.custompreference.CustomSliderPreference
            android:key="key_external_audio_device_volume"
            android:layout="@layout/settings_preference_slider_layout"
            android:title="@string/external_audio_device_volume_title"
            android:summary="@string/label_default"
            android:defaultValue="70"
            android:max="100"
            app:iconSpaceReserved="false"
            app:singleLineTitle="false" />

    </PreferenceCategory>

    <PreferenceCategory
        android:key="key_alarm_vibration_category"
        android:title="@string/vibration_category_title"
        app:allowDividerAbove="false"
        app:iconSpaceReserved="false">

        <com.best.deskclock.settings.custompreference.VibrationPatternPreference
            android:key="key_vibration_pattern"
            android:layout="@layout/settings_preference_layout"
            android:title="@string/vibration_pattern_title"
            app:iconSpaceReserved="false"
            app:singleLineTitle="false" />

        <com.best.deskclock.settings.custompreference.VibrationStartDelayPreference
            android:key="key_vibration_start_delay"
            android:layout="@layout/settings_preference_layout"
            android:title="@string/vibration_start_delay_title"
            app:iconSpaceReserved="false"
            app:singleLineTitle="false" />

        <SwitchPreferenceCompat
            android:key="key_enable_snoozed_or_dismissed_alarm_vibrations"
            android:layout="@layout/settings_preference_layout"
            android:title="@string/enable_snoozed_or_dismissed_alarm_vibrations_title"
            android:summary="@string/enable_snoozed_or_dismissed_alarm_vibrations_summary"
            android:defaultValue="false"
            app:iconSpaceReserved="false"
            app:singleLineTitle="false" />

    </PreferenceCategory>

    <PreferenceCategory
        android:title="@string/actions_category_title"
        app:allowDividerAbove="false"
        app:iconSpaceReserved="false">

        <ListPreference
            android:key="key_volume_button_setting"
            android:layout="@layout/settings_preference_layout"
            android:title="@string/volume_button_setting_title"
            android:entries="@array/volume_button_setting_entries"
            android:entryValues="@array/volume_button_setting_values"
            android:defaultValue="-1"
            app:iconSpaceReserved="false"
            app:singleLineTitle="false" />

        <ListPreference
            android:key="key_power_button"
            android:layout="@layout/settings_preference_layout"
            android:title="@string/power_button_title"
            android:entries="@array/action_setting_entries"
            android:entryValues="@array/side_button_setting_values"
            android:defaultValue="0"
            app:iconSpaceReserved="false"
            app:singleLineTitle="false" />

        <ListPreference
            android:key="key_flip_action"
            android:layout="@layout/settings_preference_layout"
            android:title="@string/flip_action_title"
            android:entries="@array/action_setting_entries"
            android:entryValues="@array/side_button_setting_values"
            android:defaultValue="1"
            app:iconSpaceReserved="false"
            app:singleLineTitle="false" />

        <ListPreference
            android:key="key_shake_action"
            android:layout="@layout/settings_preference_layout"
            android:title="@string/shake_action_title"
            android:entries="@array/action_setting_entries"
            android:entryValues="@array/side_button_setting_values"
            android:defaultValue="0"
            app:iconSpaceReserved="false"
            app:singleLineTitle="false" />

        <com.best.deskclock.settings.custompreference.CustomSliderPreference
            android:key="key_shake_intensity"
            android:layout="@layout/settings_preference_slider_layout"
            android:title="@string/shake_intensity_title"
            android:summary="@string/label_default"
            android:defaultValue="16"
            android:max="55"
            app:iconSpaceReserved="false"
            app:singleLineTitle="false" />

    </PreferenceCategory>

    <PreferenceCategory
        android:title="@string/miscellaneous_category_title"
        app:allowDividerAbove="false"
        app:iconSpaceReserved="false">

        <com.best.deskclock.settings.custompreference.AlarmNotificationReminderPreference
            android:key="key_alarm_notification_reminder"
            android:layout="@layout/settings_preference_layout"
            android:title="@string/alarm_notification_reminder_title"
            app:iconSpaceReserved="false"
            app:singleLineTitle="false" />

    </PreferenceCategory>

</PreferenceScreen>
